{
  "name": "koalafix-auto",
  "displayName": "KoalaFix automatic memory",
  "version": "0.3.0",
  "description": "Makes KoalaFix automatic in Claude Code and Cowork: the team brief at session start, recall on each prompt, work in progress started and closed for you, one browser sign-in on first use for the hooks and the KoalaFix tools alike. Installs the koalafix plugin with it. Needs Node.js 22 or later on the machine.",
  "author": {
    "name": "KoalaFix",
    "url": "https://koalafix.com"
  },
  "homepage": "https://koalafix.com",
  "repository": "https://github.com/KoalaFix/koalafix-connect",
  "license": "LicenseRef-KoalaFix-Proprietary",
  "keywords": ["memory", "team-memory", "work-items", "hooks"],
  "dependencies": ["koalafix"],
  "hooks": "./hooks/claude-code.json",
  "mcpServers": {
    "koalafix": {
      "type": "http",
      "url": "https://mcp.koalafix.com/mcp",
      "headersHelper": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/headers.mjs\" --user"
    }
  },
  "documentationUrl": "https://koalafix.com/docs",
  "supportUrl": "https://koalafix.com/support",
  "privacyPolicyUrl": "https://koalafix.com/privacy",
  "termsOfServiceUrl": "https://koalafix.com/terms"
}
