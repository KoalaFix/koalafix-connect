{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/session-start.mjs\" --user --client cursor",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/prompt.mjs\" --user --client cursor",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/stop.mjs\" --user --client cursor",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/session-end.mjs\" --user --client cursor",
        "timeout": 5
      }
    ]
  }
}
